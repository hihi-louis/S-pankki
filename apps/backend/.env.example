PORT=3001
CORS_ORIGIN=http://localhost:5173
# true = also allow browsers opened via a private-network address, so teammates on the same network can use the app
CORS_ALLOW_LAN=true
DATABASE_URL=postgresql://sbank:sbank@localhost:5432/sbank

# LLM (OpenAI-compatible endpoint, e.g. Verda inference)
LLM_BASE_URL=https://inference.verda.com/v1
LLM_MODEL=kimi-k3-1-pro
# true only if your provider does NOT cache prompt prefixes (see src/modules/chat/router.ts)
LLM_TOOL_GATING=false
# Daily token budget for free-form questions (0 = unlimited). When used up, suggested questions still work.
LLM_DAILY_TOKEN_CAP=0
LLM_API_KEY=
